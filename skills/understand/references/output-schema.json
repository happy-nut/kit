{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "understand/3",
  "title": "UNDERSTAND 설명 데이터",
  "description": "화면에 나갈 설명만 담는다. 내부 분류·평가·분석 과정은 넣지 않는다. sources 와 src 는 사실 검증용으로 남기고 화면에 내보내지 않는다. 처음부터 다 늘어놓지 않는다. 핵심 명제 하나로 시작해 story 가 그림을 한 단계씩 드러낸다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "thesis",
    "story",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "understand/3"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "thesis": {
      "$ref": "#/$defs/sentence",
      "description": "핵심 명제. 한 문장"
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure",
        "steps"
      ],
      "description": "01 작동 원리. 그림 하나를 옆에 고정하고, 스크롤하면 단계마다 그 그림의 마디와 선이 하나씩 더해진다. 마지막 단계에서 그림이 전체 구조가 된다",
      "properties": {
        "figure": {
          "$ref": "#/$defs/stage"
        },
        "vars": {
          "$ref": "#/$defs/vars"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "models"
      ],
      "description": "02 핵심 관계. 이야기에서 본 현상들을 하나로 설명하는 정신 모델. 화면에는 목록이 아니라 문단으로 나간다",
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "claim",
              "cause",
              "explains",
              "boundary"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 2,
                "maxLength": 30,
                "description": "검증된 표준 개념 이름. 예: 주인-대리인 문제"
              },
              "claim": {
                "$ref": "#/$defs/sentence",
                "description": "이 대상에서 모델이 말하는 것"
              },
              "cause": {
                "$ref": "#/$defs/sentence",
                "description": "모델의 인과 메커니즘"
              },
              "explains": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "$ref": "#/$defs/sentence"
                },
                "description": "이 모델 하나로 설명되는 서로 다른 현상"
              },
              "boundary": {
                "$ref": "#/$defs/sentence",
                "description": "모델이 설명하지 못하는 것, 성립 조건"
              },
              "src": {
                "$ref": "#/$defs/src"
              }
            }
          }
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "description": "03 적용과 한계. 모델로 실제 상황을 판단하고, 수치로 못 나타내는 조건 변화는 switch 로, 반례·트레이드오프·미확인 전제는 limits 로",
      "properties": {
        "judgments": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "situation",
              "result",
              "reason"
            ],
            "properties": {
              "situation": {
                "$ref": "#/$defs/sentence"
              },
              "result": {
                "$ref": "#/$defs/sentence"
              },
              "reason": {
                "$ref": "#/$defs/sentence"
              },
              "src": {
                "$ref": "#/$defs/src"
              }
            }
          }
        },
        "switch": {
          "$ref": "#/$defs/switch"
        },
        "limits": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "counterexample",
                  "tradeoff",
                  "assumption",
                  "unknown",
                  "condition"
                ]
              },
              "text": {
                "$ref": "#/$defs/sentence"
              },
              "src": {
                "$ref": "#/$defs/src"
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 30,
      "description": "내부 검증 자료. 화면에 내보내지 않는다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "note": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  },
  "$defs": {
    "sentence": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 18
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,30}$"
    },
    "varid": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{0,20}$",
      "description": "식에 쓰는 이름. 하이픈은 빼기와 헷갈려 쓰지 않는다"
    },
    "src": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "expr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "숫자, 입력·앞 출력 id, + - * / ( ), < <= > >= ==, && ||, min max round abs"
    },
    "switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "options"
      ],
      "description": "수치로 못 나타내는 조건 변화. 조건을 바꾸면 결과와 이유가 바뀐다",
      "properties": {
        "question": {
          "$ref": "#/$defs/sentence"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "result",
              "reason"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 30
              },
              "result": {
                "$ref": "#/$defs/sentence"
              },
              "reason": {
                "$ref": "#/$defs/sentence"
              },
              "src": {
                "$ref": "#/$defs/src"
              }
            }
          }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "nodes",
        "edges"
      ],
      "description": "단계마다 드러날 그림 전체. 선 id 는 따로 주지 않으면 「from>to」. sequence 는 nodes 가 참여자, edges 가 시간 순서의 메시지(같은 짝이 되풀이되면 id 를 준다). label 에 {변수} 를 넣으면 vars 값으로 바뀐다",
      "properties": {
        "kind": {
          "enum": [
            "causal",
            "flow",
            "stakeholder",
            "dependency",
            "state",
            "argument",
            "sequence"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "from": {
                "$ref": "#/$defs/id"
              },
              "to": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 22
              }
            }
          }
        }
      }
    },
    "vars": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption",
        "inputs",
        "outputs"
      ],
      "description": "이야기 속 수치. 입력은 그 수치가 처음 중요해지는 단계의 controls 에 놓인다. 출력은 그림 label 과 본문의 {id} 에 들어가 입력이 바뀌면 함께 바뀐다",
      "properties": {
        "assumption": {
          "$ref": "#/$defs/sentence"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "unit",
              "min",
              "max",
              "step",
              "value"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/varid"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "unit": {
                "type": "string",
                "maxLength": 8
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "minimum": 0.0001
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "unit",
              "expr"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/varid"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "unit": {
                "type": "string",
                "maxLength": 8
              },
              "expr": {
                "$ref": "#/$defs/expr"
              },
              "digits": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "show"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/sentence"
          },
          "description": "{변수 id} 를 넣으면 계산된 값이 들어간다"
        },
        "show": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,30}(>[a-z][a-z0-9-]{0,30})?$"
          },
          "description": "이 단계에서 새로 드러낼 마디 id 와 선 id(from>to). 한 단계에 넷까지"
        },
        "controls": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/varid"
          },
          "description": "이 단계에서 손댈 입력"
        },
        "notes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "when",
              "text"
            ],
            "properties": {
              "when": {
                "$ref": "#/$defs/expr"
              },
              "text": {
                "$ref": "#/$defs/sentence"
              }
            }
          },
          "description": "조건식이 참일 때만 보이는 결과"
        },
        "src": {
          "$ref": "#/$defs/src"
        }
      }
    }
  }
}
