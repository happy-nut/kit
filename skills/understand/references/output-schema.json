{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "understand/1",
  "title": "UNDERSTAND 출력 데이터",
  "description": "분석 결과 중 사용자에게 보일 것만 담는다. 내부 분류·평가·사고도구 이름은 넣지 않는다. scripts/validate.py 가 이 파일을 읽어 검사하고 scripts/render.py 가 assets/template.html 에 넣는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "essence", "structure", "mechanism", "limits", "principles", "checks", "sources"],
  "properties": {
    "schema": {"const": "understand/1"},
    "title": {"type": "string", "minLength": 1, "maxLength": 60},
    "essence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition"],
      "properties": {
        "definition": {"$ref": "#/$defs/sentence"},
        "support": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/sentence"}},
        "status": {"$ref": "#/$defs/status"},
        "sources": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "structure": {
      "oneOf": [
        {"$ref": "#/$defs/na"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes"],
          "properties": {
            "relation": {"type": "string", "maxLength": 40, "description": "L2 항목들이 L1 과 맺는 실제 관계. 예: 구성 요소, 주장과 근거, 목적과 수단"},
            "nodes": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/node"}},
            "edges": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/edge"}, "description": "계층으로 담기지 않는 L2 사이의 관계. 있으면 같은 영역에 관계도로 그린다"}
          }
        }
      ]
    },
    "mechanism": {
      "oneOf": [
        {"$ref": "#/$defs/na"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocks"],
          "properties": {"blocks": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/block"}}}
        }
      ]
    },
    "limits": {
      "oneOf": [
        {"$ref": "#/$defs/na"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["items"],
          "properties": {
            "items": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/limit"}},
            "scenario": {"$ref": "#/$defs/scenario"}
          }
        }
      ]
    },
    "principles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": {"enum": ["principle", "fact"], "description": "principle: 다른 상황에 옮겨 쓸 원리. fact: 옮길 원리가 없어 이번에 기억할 사실만 남긴다"},
        "items": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/principle"}}
      }
    },
    "checks": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/check"}},
    "sources": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "sentence": {"type": "string", "minLength": 2, "maxLength": 220},
    "label": {"type": "string", "minLength": 1, "maxLength": 18},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$"},
    "depth": {"enum": ["overview", "standard", "deep"], "description": "이 항목이 처음 보이는 탐색 깊이. 없으면 overview"},
    "status": {"enum": ["fact", "inference", "assumption", "example", "unknown"], "description": "fact 는 표시하지 않는다. 나머지는 항목 옆에 추론·가정·예시·미확인으로 표시한다"},
    "sourceRefs": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/id"}},
    "na": {
      "type": "object",
      "additionalProperties": false,
      "required": ["na"],
      "properties": {"na": {"$ref": "#/$defs/sentence"}}
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "label", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "level": {"enum": [1, 2, 3]},
        "parent": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/label"},
        "summary": {"$ref": "#/$defs/sentence"},
        "detail": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/sentence"}},
        "depth": {"$ref": "#/$defs/depth"},
        "status": {"$ref": "#/$defs/status"},
        "sources": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label"],
      "properties": {
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 12}
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "body"],
          "properties": {
            "type": {"const": "text"},
            "title": {"type": "string", "maxLength": 40},
            "body": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/sentence"}},
            "depth": {"$ref": "#/$defs/depth"},
            "status": {"$ref": "#/$defs/status"},
            "sources": {"$ref": "#/$defs/sourceRefs"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "steps"],
          "properties": {
            "type": {"const": "steps"},
            "title": {"type": "string", "maxLength": 40},
            "steps": {
              "type": "array", "minItems": 2, "maxItems": 8,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["label", "body"],
                "properties": {"label": {"$ref": "#/$defs/label"}, "body": {"$ref": "#/$defs/sentence"}, "status": {"$ref": "#/$defs/status"}}
              }
            },
            "depth": {"$ref": "#/$defs/depth"},
            "sources": {"$ref": "#/$defs/sourceRefs"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "nodes", "edges"],
          "properties": {
            "type": {"const": "diagram"},
            "title": {"type": "string", "maxLength": 40},
            "nodes": {
              "type": "array", "minItems": 2, "maxItems": 10,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["id", "label", "detail"],
                "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "detail": {"$ref": "#/$defs/sentence"}, "status": {"$ref": "#/$defs/status"}}
              }
            },
            "edges": {"type": "array", "minItems": 1, "maxItems": 14, "items": {"$ref": "#/$defs/edge"}},
            "depth": {"$ref": "#/$defs/depth"},
            "sources": {"$ref": "#/$defs/sourceRefs"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "columns", "rows"],
          "properties": {
            "type": {"const": "compare"},
            "title": {"type": "string", "maxLength": 40},
            "basis": {"type": "string", "maxLength": 80, "description": "비교 기준"},
            "columns": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 18}},
            "rows": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["label", "cells"],
                "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 24}, "status": {"$ref": "#/$defs/status"}, "sources": {"$ref": "#/$defs/sourceRefs"}, "cells": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 80}}}
              }
            },
            "depth": {"$ref": "#/$defs/depth"},
            "sources": {"$ref": "#/$defs/sourceRefs"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "title", "body"],
          "properties": {
            "type": {"const": "example"},
            "title": {"type": "string", "maxLength": 40},
            "body": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/sentence"}},
            "real": {"type": "boolean", "description": "true 면 실제 사례. 없거나 false 면 지어낸 예시로 표시한다"},
            "depth": {"$ref": "#/$defs/depth"},
            "sources": {"$ref": "#/$defs/sourceRefs"}
          }
        }
      ]
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {"enum": ["condition", "premise", "change", "counterexample", "exception", "tradeoff", "boundary", "unknown"]},
        "text": {"$ref": "#/$defs/sentence"},
        "depth": {"$ref": "#/$defs/depth"},
        "status": {"$ref": "#/$defs/status"},
        "sources": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {
        "question": {"$ref": "#/$defs/sentence"},
        "options": {
          "type": "array", "minItems": 2, "maxItems": 5,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "result", "reason"],
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 30},
              "result": {"$ref": "#/$defs/sentence"},
              "reason": {"$ref": "#/$defs/sentence"},
              "status": {"$ref": "#/$defs/status"}
            }
          }
        },
        "depth": {"$ref": "#/$defs/depth"}
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement"],
      "properties": {
        "statement": {"$ref": "#/$defs/sentence"},
        "condition": {"$ref": "#/$defs/sentence"},
        "example": {"$ref": "#/$defs/sentence"},
        "depth": {"$ref": "#/$defs/depth"},
        "sources": {"$ref": "#/$defs/sourceRefs"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "answer", "explanation"],
      "properties": {
        "kind": {"enum": ["rebuild", "cause", "predict", "transfer", "spot-error"]},
        "question": {"$ref": "#/$defs/sentence"},
        "answer": {"$ref": "#/$defs/sentence"},
        "explanation": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/sentence"}},
        "depth": {"$ref": "#/$defs/depth"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "url": {"type": "string", "pattern": "^https?://"},
        "note": {"type": "string", "maxLength": 160}
      }
    }
  }
}
