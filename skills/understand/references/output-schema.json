{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "understand/5",
  "title": "UNDERSTAND 뼈대 데이터",
  "description": "대상의 큰 뼈대(몇 안 되는 부분과 그 사이의 연결) 하나가 설명 전체의 축이다. 아는 그림에서 출발해 뼈대를 한두 부분씩 세우고, 현상과 추론을 뼈대 위의 길로 설명한다. 화면에는 조절 장치가 없다. sources 와 src 는 검증용이고 화면에 내보내지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "thesis", "skeleton", "build", "phenomena", "inferences", "sources"],
  "properties": {
    "schema": {"const": "understand/5"},
    "title": {"type": "string", "minLength": 1, "maxLength": 60},
    "thesis": {"$ref": "#/$defs/sentence", "description": "뼈대 전체가 어떻게 움직이는지 한 문장으로"},
    "skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parts", "links"],
      "description": "대상을 이루는 큰 부분과 그 사이의 연결. 세부 사실이 아니라 결과를 정하는 구조만",
      "properties": {
        "parts": {
          "type": "array", "minItems": 3, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "name"],
            "properties": {
              "id": {"$ref": "#/$defs/pid"},
              "name": {"type": "string", "minLength": 1, "maxLength": 12}
            }
          }
        },
        "links": {
          "type": "array", "minItems": 2, "maxItems": 9,
          "description": "from 이 to 에 하는 일. label 은 동사구로",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["from", "to", "label"],
            "properties": {
              "from": {"$ref": "#/$defs/pid"},
              "to": {"$ref": "#/$defs/pid"},
              "label": {"type": "string", "minLength": 1, "maxLength": 14}
            }
          }
        }
      }
    },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known", "map", "at", "differs"],
      "description": "01 출발점. 사용자가 이미 아는 그림을 같은 뼈대 위에 겹친다. map 은 부분마다 아는 그림의 짝, at 은 결정적인 차이가 있는 부분. 맞는 기존 지식이 없으면 뺀다",
      "properties": {
        "known": {"$ref": "#/$defs/sentence"},
        "map": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 12}
        },
        "at": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/pid"}},
        "differs": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/sentence"}},
        "src": {"$ref": "#/$defs/src"}
      }
    },
    "build": {
      "type": "array", "minItems": 3, "maxItems": 7,
      "description": "02 뼈대. 한 단계에 부분을 둘까지 세운다. 아직 세우지 않은 부분의 이름은 쓰지 않는다",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "body"],
        "properties": {
          "add": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/pid"}},
          "focus": {
            "type": "array", "maxItems": 4,
            "description": "이 단계에서 짚는 부분 id 나 연결 \"from>to\". 빼면 새로 세운 부분과 새로 생긴 연결",
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,20}(>[a-z][a-z0-9]{0,20})?$"}
          },
          "title": {"type": "string", "minLength": 2, "maxLength": 40},
          "body": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/sentence"}},
          "src": {"$ref": "#/$defs/src"}
        }
      }
    },
    "phenomena": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "description": "03 뼈대로 설명되는 현상. path 는 그 현상이 지나는 부분들이고 이웃한 둘은 연결돼 있어야 한다",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["text", "path"],
        "properties": {
          "text": {"$ref": "#/$defs/sentence"},
          "path": {"$ref": "#/$defs/path"},
          "src": {"$ref": "#/$defs/src"}
        }
      }
    },
    "inferences": {
      "type": "array", "minItems": 1, "maxItems": 4,
      "description": "04 원문에 없던 질문을 뼈대로 답한다. reason 은 사실이 아니라 부분과 연결로 쓴다",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["question", "answer", "reason", "path"],
        "properties": {
          "question": {"$ref": "#/$defs/sentence"},
          "answer": {"$ref": "#/$defs/sentence"},
          "reason": {"$ref": "#/$defs/sentence"},
          "path": {"$ref": "#/$defs/path"}
        }
      }
    },
    "limits": {
      "type": "array", "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "text"],
        "properties": {
          "kind": {"enum": ["counterexample", "tradeoff", "assumption", "unknown", "condition"]},
          "text": {"$ref": "#/$defs/sentence"},
          "src": {"$ref": "#/$defs/src"}
        }
      }
    },
    "sources": {
      "type": "array", "maxItems": 30,
      "description": "내부 검증 자료. 화면에 내보내지 않는다",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "label": {"type": "string", "minLength": 1, "maxLength": 200},
          "url": {"type": "string", "pattern": "^https?://"},
          "note": {"type": "string", "maxLength": 200}
        }
      }
    }
  },
  "$defs": {
    "sentence": {"type": "string", "minLength": 2, "maxLength": 200},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$"},
    "pid": {"type": "string", "pattern": "^[a-z][a-z0-9]{0,20}$"},
    "src": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/id"}},
    "path": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/pid"}}
  }
}
